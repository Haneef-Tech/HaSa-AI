# ---- Firebase client (public, safe to expose) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Firebase Admin (SERVER ONLY — never prefix with NEXT_PUBLIC_) ----
# Never commit real values. Keep .env.local out of git.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the full private key with escaped newlines (\n). Code converts \n -> newline.
FIREBASE_ADMIN_PRIVATE_KEY=

# ---- LLM providers (SERVER ONLY — never prefix with NEXT_PUBLIC_) ----
# Keys stay on the server. The browser only ever talks to /api/* routes.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NAROROUTER_API_KEY=
# Legacy alias (still honored if NAROROUTER_API_KEY is unset):
# NARA_ROUTER_API_KEY=

# ---- Model selection (non-secret; empty values are filtered out) ----
# Per-role overrides (each optional; built-in free defaults apply otherwise):
# GROQ_FAST_MODEL=
# GROQ_CODING_MODEL=
# GEMINI_FAST_MODEL=
# GEMINI_REASONING_MODEL=
# GEMINI_LONG_CONTEXT_MODEL=
# OPENROUTER_GENERAL_MODEL=
# OPENROUTER_CODING_MODEL=
# OPENROUTER_REASONING_MODEL=
# Ordered OpenRouter fallback list (comma-separated, tried in order):
# OPENROUTER_MODELS=deepseek/deepseek-v4-flash-0731:free,qwen/qwen3.8-27b:free,z-ai/glm-5.2:free
# (legacy single-model override: OPENROUTER_MODEL=...)
# NaroRouter endpoint + models (OpenAI-compatible only; missing = unavailable):
# NAROROUTER_BASE_URL=https://router.bynara.id/v1
# NAROROUTER_GENERAL_MODEL=agnes-2.5-flash
# NAROROUTER_MODELS=agnes-2.5-flash,laguna-s-2.1,ling-3.0-flash-sante-free
# (legacy aliases: NARA_ROUTER_API_KEY=, NARA_MODEL=, NARA_MODELS=)
# Legacy single-model pins (still honored):
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# (lite second: per-model quotas — when flash 429s, lite still serves)
# LLM_MOCK_ONLY=true  # force deterministic mock responses (tests, offline dev)

# ---- LLM transport tuning (SERVER ONLY) ----
# LLM_REQUEST_TIMEOUT_MS=60000
# LLM_STREAM_START_TIMEOUT_MS=25000
# LLM_STREAM_IDLE_TIMEOUT_MS=45000
# LLM_MODEL_BUDGET_MS=120000
# LLM_MAX_RETRIES=1

# ---- Admin panel (SERVER ONLY — set real values in .env.local, never commit) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Outbound email (SERVER ONLY, optional) ----
# Gmail free path: 2-Step Verification → App passwords → Mail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ---- Storage quota display (bytes; default 1 GiB Spark free tier) ----
# FIREBASE_QUOTA_BYTES=1073741824
